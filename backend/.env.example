# Copy this file to ".env" and fill in real values before deploying.

# Port the API listens on inside the container.
PORT=3000

# Connection string to the PostgreSQL database.
# In Docker Compose this points at the "db" service.
DATABASE_URL=postgres://timetracker:CHANGE_THIS_PASSWORD@db:5432/timetracker

# Secret used to sign login tokens. Make this a long random string.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
